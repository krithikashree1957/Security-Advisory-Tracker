# Security Advisory Tracker — Environment Variables Template
# Copy this file to .env and fill in your own values:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# IMPORTANT: Never commit your real .env file to Git.
# It is already listed in .gitignore.

# Bright Data account API key
# Used later (Phase 6) to trigger and fetch results from the
# custom Scraper Studio collector for GitHub Security Advisories.
# This project does NOT integrate with Bright Data yet.
BRIGHT_DATA_API_KEY=